# Create a project at https://supabase.com and copy these from Project Settings > API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# WhatsApp number in international format, digits only (example: 96170123456)
VITE_WHATSAPP_NUMBER=96171945469

# Optional display currency used in the storefront
VITE_CURRENCY=USD
